# .env.local 에 넣을 것 — 이 파일은 **이름만 적은 본보기**다. 값은 비워 두었다.
# 실제 .env.local 은 .gitignore 에 걸려 있어야 한다 (08 · 1번).
#
# DB 쪽(DATABASE_URL 등)은 이미 Neon 콘솔에서 받아 넣어 두었으므로 여기 다시 적지 않는다.

# -----------------------------------------------------------------------------
# Auth.js — 세션 쿠키 서명 (F38 · F39)
# -----------------------------------------------------------------------------
# 세션 표가 없으므로(JWT 쿠키) 이 키가 곧 세션의 안전장치다.
# 새로 만들기:  npx auth secret     또는     openssl rand -base64 32
# 이 값이 바뀌면 이미 로그인한 사람이 전부 로그아웃된다.
AUTH_SECRET=

# 배포 주소. 로컬에서는 없어도 되고, Vercel 은 자동으로 잡는다.
# 직접 띄우는 서버라면 구글 콜백 주소와 같은 값을 넣는다.
# AUTH_URL=https://washed.example.com

# -----------------------------------------------------------------------------
# 구글 로그인 (F39 · 05 P11)
# -----------------------------------------------------------------------------
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
#   · 애플리케이션 유형: 웹 애플리케이션
#   · 승인된 리디렉션 URI 에 아래 둘을 모두 넣는다
#       http://localhost:3000/api/auth/callback/google
#       https://<배포주소>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 계정 선택창을 학교 계정 쪽으로 기울이는 **힌트**일 뿐이다 (05 P11 · 08 · 1번).
# 자격 판단은 서버가 이메일 끝(`ac.kr`)을 보고 한다 — 이 값을 믿지 않는다.
# 비워 두면 힌트 없이 모든 구글 계정이 목록에 뜨고, 학교 계정이 아니면 서버가 막는다.
GOOGLE_HD_HINT=g.eulji.ac.kr

# -----------------------------------------------------------------------------
# 메일 발송 — Resend (F14 · F35)
# -----------------------------------------------------------------------------
# https://resend.com → API Keys 에서 발급 (re_ 로 시작)
RESEND_API_KEY=

# 보내는 주소. 도메인을 Resend 에 등록(DNS 에 SPF · DKIM 추가)해야 실제로 나간다.
# 등록 전에는 onboarding@resend.dev 로만 보낼 수 있고, 그 주소는
# **Resend 에 가입한 본인 메일로만** 도착한다 — 팀원 테스트에는 못 쓴다.
MAIL_FROM=Washed <noreply@example.ac.kr>

# 둘 다 비어 있으면 메일을 보내지 않고 **서버 콘솔에 코드를 찍는다**(개발 전용).
# NODE_ENV=production 에서는 비어 있으면 그대로 실패한다.
