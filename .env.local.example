# .env.local 에 넣을 것 — 이 파일은 **이름만 적은 본보기**다. 값은 비워 두었다.
# 실제 .env.local 은 .gitignore 에 걸려 있어야 한다 (08 · 1번).

# -----------------------------------------------------------------------------
# 데이터베이스 — Neon (06 저장 항목 · 08 · 1번)
# -----------------------------------------------------------------------------
# Neon 콘솔 → 프로젝트 → Connection string 에서 그대로 복사한다.
# 두 값이 **모두** 있어야 한다 — 없으면 db:migrate · db:check · db:push ·
# admin:create 가 전부 즉시 실패한다.
#   DATABASE_URL           풀링(-pooler) 주소. 앱 런타임과 db:check 가 쓴다.
#   DATABASE_URL_UNPOOLED  직결 주소. db:migrate · db:push · admin:create 가 쓴다.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# -----------------------------------------------------------------------------
# Auth.js — 세션 쿠키 서명 (F38 · F39)
# -----------------------------------------------------------------------------
# 세션 표가 없으므로(JWT 쿠키) 이 키가 곧 세션의 안전장치다.
# 새로 만들기:  npx auth secret     또는     openssl rand -base64 32
# 이 값이 바뀌면 이미 로그인한 사람이 전부 로그아웃된다.
AUTH_SECRET=

# 배포 주소. 로컬에서는 없어도 되고, Vercel 은 자동으로 잡는다.
# 직접 띄우는 서버라면 구글 콜백 주소와 같은 값을 넣는다.
# AUTH_URL=https://washed.example.com

# -----------------------------------------------------------------------------
# 구글 로그인 (F39 · 05 P11)
# -----------------------------------------------------------------------------
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
#   · 애플리케이션 유형: 웹 애플리케이션
#   · 승인된 리디렉션 URI 에 아래 둘을 모두 넣는다
#       http://localhost:3000/api/auth/callback/google
#       https://<배포주소>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 계정 선택창을 학교 계정 쪽으로 기울이는 **힌트**일 뿐이다 (05 P11 · 08 · 1번).
# 자격 판단은 서버가 이메일 끝(`ac.kr`)을 보고 한다 — 이 값을 믿지 않는다.
# 비워 두면 힌트 없이 모든 구글 계정이 목록에 뜨고, 학교 계정이 아니면 서버가 막는다.
GOOGLE_HD_HINT=g.eulji.ac.kr

# -----------------------------------------------------------------------------
# 메일 발송 (F14 · F35)
# -----------------------------------------------------------------------------
# 어느 경로로 보낼지 **명시적으로** 고른다. 비워 두면 개발은 console, 운영은 resend 다.
#
#   console  개발 전용. Resend 를 부르지 않고 인증번호를 터미널에 찍는다.
#            (브라우저 콘솔이 아니라 `npm run dev` 를 띄운 터미널이다.)
#            응답에도 devCode 로 함께 내려와 화면에서 바로 볼 수 있다.
#   resend   실제 발송. 아래 두 값이 반드시 있어야 하고, 실패하면 그대로 실패한다.
#
# 운영(NODE_ENV=production)에서 console 은 **거부한다** — 인증번호가 서버 로그에만
# 남고 사용자에게는 영영 가지 않는 상태를 허용하지 않기 위해서다.
MAIL_MODE=console

# https://resend.com → API Keys 에서 발급 (re_ 로 시작)
RESEND_API_KEY=

# 보내는 주소. 도메인을 Resend 에 등록(DNS 에 SPF · DKIM 추가)해야 실제로 나간다.
# 등록 전에는 onboarding@resend.dev 로만 보낼 수 있고, 그 주소는
# **Resend 에 가입한 본인 메일로만** 도착한다 — 팀원 테스트에는 못 쓴다.
#
# **비워 둔다.** 예시값을 그대로 두면 MAIL_MODE=resend 일 때 등록되지 않은
# 도메인으로 보내려다 실패한다. 실제 값 보기: Washed <noreply@example.ac.kr>
MAIL_FROM=

# -----------------------------------------------------------------------------
# 폰 알림(푸시) — web-push (F40 · F41 · 05 P26 · 06 「푸시 구독」 · 08 · 12번)
# -----------------------------------------------------------------------------
# 새로 만들기:  npx web-push generate-vapid-keys
# 공개 키는 브라우저로 내려가고(NEXT_PUBLIC_ 접두사), 비밀 키는 서버에만 둔다.
# 길이가 맞아야 한다 — 공개 키 87자, 비밀 키 43자(둘 다 URL-safe base64, "=" 없이).
#
# **이 값이 바뀌면 그 전에 등록된 구독은 전부 못 쓰게 된다** — 사용자가 알림을
# 다시 허용해야 한다. 한 번 정하면 바꾸지 않는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 이 서버가 누구인지 브라우저의 푸시 서비스(FCM 등)에 알리는 값이다.
# mailto: 나 https:// 로 시작해야 한다.
VAPID_SUBJECT=mailto:admin@example.ac.kr

# -----------------------------------------------------------------------------
# 정리 배치 (05 P23 · P24 · 08 · 9번 · /api/cron/cleanup)
# -----------------------------------------------------------------------------
# 하루 한 번 도는 배치를 부를 때 쓰는 열쇠다. vercel.json 의 crons 가 이 라우트를
# 매일 18:00 UTC(= 한국 03:00)에 부르고, Vercel 은 이 값이 있으면
# `Authorization: Bearer <CRON_SECRET>` 헤더를 붙여 준다.
#
# 하는 일:
#   · 올린 지 3개월이 지난 신고 증거 사진 삭제 (05 P23)
#   · 탈퇴 신청 후 14일이 지난 계정과 그 사람이 올린 사진 삭제 (05 P24)
#
# **이 값이 없으면 라우트가 401 로 전부 막는다.** 배치는 사람을 지우므로,
# 환경변수를 깜빡한 배포에서 누구나 부를 수 있게 두지 않는다 — 비어 있으면
# 열리는 것이 아니라 잠긴다.
#
# 새로 만들기:  openssl rand -base64 32
#
# 손으로 한 번 돌려 보기:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/cleanup
CRON_SECRET=
